</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/biodiversity-linkage.html">Biodiversity Linkage</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/business-alliances.html">Business Alliances</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/combined-strategic-approaches.html">Combined Strategic Approaches</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/diversification.html">Diversification</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/equipment.html">Equipment</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/financial-management-capacity-1.html">Financial Management Capacity</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/governance-1.html">Governance</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/government-requirements.html">Government Requirements</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/infrastucture.html">Infrastructure</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/inputs.html">Inputs</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/market-demand.html">Market Demand</a></td>
</tr>
<tr>
<td><a class="internal-link" href="inventory-collections/ownership.html">Ownership</a></td>
